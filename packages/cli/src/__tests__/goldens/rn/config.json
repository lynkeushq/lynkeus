  "every key": {
    "config": {
      "cases": {
        "dir": "qa/cases",
        "fixtures": "node qa/fixtures.js",
        "macros": {
          "app.login": [
            {
              "app.call": {
                "command": "reset"
              }
            }
          ]
        },
        "base": "<top>/app"
      },
      "ci": {
        "backend": {
          "up": "docker compose up -d",
          "ready": "http://127.0.0.1:3000/health"
        },
        "hosts": {
          "count": 2
        },
        "push": true,
        "run": [
          "--once"
        ]
      },
      "entry": "qa/headless.tsx",
      "apiEnv": "API_URL",
      "apiUrl": "http://127.0.0.1:3000",
      "port": 8200,
      "device": "iPhone 17 Pro",
      "app": "com.example.shop",
      "report": {
        "afterPush": "delete"
      },
      "language": "es",
      "locale": {
        "languageTag": "es-AR",
        "country": "AR"
      },
      "launch": {
        "seed": 7,
        "locale": "es-ar",
        "timeZone": "America/Argentina/Buenos_Aires",
        "epoch": "2026-03-01T09:00:00Z"
      },
      "attachTimeout": 30000,
      "errorCopy": [
        "something went wrong",
        "try again"
      ],
      "live": [
        "^clock$"
      ],
      "strictMode": true,
      "crawl": {
        "never": [
          "delete"
        ],
        "close": [
          "close"
        ],
        "back": [
          "back"
        ]
      }
    },
    "port": 8200,
    "errorCopy": "something went wrong|try again",
    "launch": {
      "seed": "7",
      "locale": "es-AR",
      "timeZone": "America/Argentina/Buenos_Aires",
      "epoch": "2026-03-01T09:00:00.000Z"
    },
    "launchEnv": {
      "LYNKEUS_SEED": "7",
      "LYNKEUS_LOCALE": "es-AR",
      "LYNKEUS_TIME_ZONE": "America/Argentina/Buenos_Aires",
      "TZ": "America/Argentina/Buenos_Aires",
      "LYNKEUS_EPOCH": "2026-03-01T09:00:00.000Z"
